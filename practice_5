public class LibraryService(InMemoryLibraryRepository repo, ILogger<LibraryService> logger)
{
    public const int MaxActiveLoans = 3;

    public Loan LoanBook(int readerId, int bookId)
    {
        var reader = repo.FindReader(readerId) ?? throw new NotFoundException("Reader", readerId);
        if (reader.IsBlocked) throw new ReaderBlockedException(readerId);

        var book = repo.FindBook(bookId) ?? throw new NotFoundException("Book", bookId);
        if (book.Status == BookStatus.Loaned) throw new BookUnavailableException(bookId);

        if (reader.Loans.Count(l => !l.IsReturned) >= MaxActiveLoans)
            throw new LoanLimitExceededException(readerId, MaxActiveLoans);

        var loan = new Loan
        {
            BookId = bookId,
            DueDate = DateOnly.FromDateTime(DateTime.Today).AddDays(14)
        };

        book.Status = BookStatus.Loaned;
        reader.Loans.Add(loan);
        repo.Save();

        // Структурированный лог успешной выдачи
        logger.LogInformation("Книга {BookId} успешно выдана читателю {ReaderId} до {DueDate}", bookId, readerId, loan.DueDate);

        return loan;
    }

    public void ReturnBook(int readerId, int bookId)
    {
        var reader = repo.FindReader(readerId) ?? throw new NotFoundException("Reader", readerId);
        var book = repo.FindBook(bookId) ?? throw new NotFoundException("Book", bookId);

        var loan = reader.Loans.FirstOrDefault(l => l.BookId == bookId && !l.IsReturned)
                   ?? throw new LoanNotFoundException(readerId, bookId);

        loan.IsReturned = true;
        book.Status = BookStatus.Available;
        repo.Save();

        // Структурированный лог возврата
        logger.LogInformation("Книга {BookId} возвращена читателем {ReaderId}", bookId, readerId);
    }
}





using Library.App.Exceptions;
using Microsoft.AspNetCore.Diagnostics;
using Microsoft.AspNetCore.Mvc;

namespace Library.Api;

public sealed class GlobalExceptionHandler(ILogger<GlobalExceptionHandler> logger) : IExceptionHandler
{
    public async ValueTask<bool> TryHandleAsync(HttpContext context, Exception exception, CancellationToken ct)
    {
        logger.LogError(exception, "Ошибка при обработке запроса {Path}", context.Request.Path);

        var (status, title) = exception switch
        {
            NotFoundException => (StatusCodes.Status404NotFound, "Ресурс не найден"),
            DataAccessException => (StatusCodes.Status503ServiceUnavailable, "Сервис временно недоступен"),
            DomainException => (StatusCodes.Status422UnprocessableEntity, "Нарушено бизнес-правило"),
            _ => (StatusCodes.Status500InternalServerError, "Внутренняя ошибка сервера")
        };

        var problem = new ProblemDetails
        {
            Status = status,
            Title = title,
            Detail = exception.Message
        };

        if (exception is AppException appException)
        {
            problem.Extensions["errorCode"] = appException.ErrorCode;
        }

        context.Response.StatusCode = status;
        await context.Response.WriteAsJsonAsync(problem, ct);

        return true; // Исключение успешно перехвачено и обработано
    }
}







