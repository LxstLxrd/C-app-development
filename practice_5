public Result<Reader> RegisterReader(string name, string email)
{
    if (string.IsNullOrWhiteSpace(name))
        return Result<Reader>.Fail("Имя не может быть пустым");

    if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        return Result<Reader>.Fail("Некорректный email");

    var readers = repo.GetReaders();
    int newId = readers.Count > 0 ? readers.Max(r => r.Id) + 1 : 1;

    var reader = new Reader
    {
        Id = newId,
        Name = name,
        Email = email
    };

    readers.Add(reader);
    repo.Save();

    return Result<Reader>.Ok(reader);
}
