static void Run(string title, Action action)
{
    Console.WriteLine($"--- {title}");
    try
    {
        action();
        Console.WriteLine("OK");
    }
    // Уровень 3.1: Фильтры when для NotFoundException
    catch (NotFoundException ex) when (ex.EntityName == "Reader")
    {
        Console.WriteLine($"Читатель не зарегистрирован. Оформите читательский билет (Ключ: {ex.Key}).");
    }
    catch (NotFoundException ex) when (ex.EntityName == "Book")
    {
        Console.WriteLine($"Книга отсутствует в каталоге (Ключ: {ex.Key}).");
    }
    catch (NotFoundException ex)
    {
        Console.WriteLine($"Не найдено: {ex.EntityName} #{ex.Key}");
    }
    catch (BookUnavailableException ex)
    {
        Console.WriteLine("Выберите другую книгу: " + ex.Message);
    }
    catch (LoanLimitExceededException ex)
    {
        Console.WriteLine($"Сначала верните одну из книг (Лимит: {ex.Limit}): {ex.Message}");
    }
    catch (ReaderBlockedException ex)
    {
        Console.WriteLine("Доступ заблокирован: " + ex.Message);
    }
    catch (LoanNotFoundException ex)
    {
        Console.WriteLine("Ошибка возврата: " + ex.Message);
    }
    catch (DataAccessException ex)
    {
        Console.WriteLine("Сервис временно недоступен, попробуйте позже.");
        // Раскрываем innerException для отладки
        if (ex.InnerException is not null)
        {
            Console.WriteLine($"[Debug InnerException]: {ex.InnerException.GetType().Name} -> {ex.InnerException.Message}");
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine("Непредвиденная ошибка. Подробности для разработчика:\n" + ex);
    }
}

