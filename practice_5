using Library.App.Data;
using Library.App.Exceptions;
using Library.App.Services;

namespace Library.Tests;

public class LibraryServiceTests
{
    [Fact]
    public void LoanBook_ReaderNotFound_ThrowsNotFoundException()
    {
        var service = new LibraryService(new InMemoryLibraryRepository());

        var ex = Assert.Throws<NotFoundException>(() => service.LoanBook(99, 1));

        Assert.Equal("Reader", ex.EntityName);
        Assert.Equal(99, ex.Key);
    }

    [Fact]
    public void LoanBook_BookUnavailable_ThrowsBookUnavailableException()
    {
        var repo = new InMemoryLibraryRepository();
        var service = new LibraryService(repo);
        
        service.LoanBook(1, 1); // Первичная выдача

        var ex = Assert.Throws<BookUnavailableException>(() => service.LoanBook(1, 1));
        Assert.Equal(1, ex.BookId);
    }

    [Fact]
    public void LoanBook_ReaderBlocked_ThrowsReaderBlockedException()
    {
        var repo = new InMemoryLibraryRepository();
        var service = new LibraryService(repo);
        // Читатель с ID=2 (Борис) по умолчанию заблокирован в InMemoryLibraryRepository

        var ex = Assert.Throws<ReaderBlockedException>(() => service.LoanBook(2, 2));
        Assert.Equal(2, ex.ReaderId);
    }

    [Fact]
    public void Save_StorageFailure_ThrowsDataAccessExceptionWithIOExceptionInner()
    {
        var repo = new InMemoryLibraryRepository
        {
            SimulateStorageFailure = true
        };
        var service = new LibraryService(repo);

        // Пытаемся совершить операцию, которая вызывает Save()
        var ex = Assert.Throws<DataAccessException>(() => service.LoanBook(1, 1));

        Assert.NotNull(ex.InnerException);
        Assert.IsType<IOException>(ex.InnerException);
    }
}

