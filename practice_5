    public int BookId { get; }

    public LoanNotFoundException(int readerId, int bookId)
        : base("loan_not_found", $"У читателя #{readerId} не найдена активная выдача книги #{bookId}.")
    {
        ReaderId = readerId;
        BookId = bookId;
