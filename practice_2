  using System;
using System.Collections.Generic;
using System.Diagnostics;

class Program
{
    static void Main()
    {
        int elementCount = 100_000;
        Console.WriteLine($"=== Сравнение коллекций на {elementCount:N0} элементах ===\n");

        // 1. Тест List<T>
        RunListTests(elementCount);

        // 2. Тест HashSet<T>
        RunHashSetTests(elementCount);

        // 3. Тест LinkedList<T>
        RunLinkedListTests(elementCount);

        // 4. Тест Dictionary<TKey, TValue>
        RunDictionaryTests(elementCount);
    }

    static void RunListTests(int count)
    {
        var stopwatch = new Stopwatch();
        var list = new List<T>();

        // Добавление (Add в конец - O(1) амортизированное)
        stopwatch.Start();
        for (int i = 0; i < count; i++) list.Add(i);
        stopwatch.Stop();
        Console.WriteLine($"List<T>    | Добавление: {stopwatch.ElapsedMilliseconds} мс");

        // Поиск (Contains - O(n))
        stopwatch.Restart();
        bool found = list.Contains(count - 1);
        stopwatch.Stop();
        Console.WriteLine($"           | Поиск (в конце): {stopwatch.ElapsedTicks} такт(ов)");

        // Удаление (Remove в начале - O(n) со смещением элементов)
        stopwatch.Restart();
        list.RemoveAt(0);
        stopwatch.Stop();
        Console.WriteLine($"           | Удаление первого: {stopwatch.ElapsedTicks} такт(ов)\n");
    }

    static void RunHashSetTests(int count)
    {
        var stopwatch = new Stopwatch();
        var hashSet = new HashSet<int>();

        // Добавление (Add - O(1) в среднем)
        stopwatch.Start();
        for (int i = 0; i < count; i++) hashSet.Add(i);
        stopwatch.Stop();
        Console.WriteLine($"HashSet<T> | Добавление: {stopwatch.ElapsedMilliseconds} мс");

        // Поиск (Contains - O(1) в среднем)
        stopwatch.Restart();
        bool found = hashSet.Contains(count - 1);
        stopwatch.Stop();
        Console.WriteLine($"           | Поиск: {stopwatch.ElapsedTicks} такт(ов)");

        // Удаление (Remove - O(1) в среднем)
        stopwatch.Restart();
        hashSet.Remove(0);
        stopwatch.Stop();
        Console.WriteLine($"           | Удаление: {stopwatch.ElapsedTicks} такт(ов)\n");
    }

    static void RunLinkedListTests(int count)
    {
        var stopwatch = new Stopwatch();
        var linkedList = new LinkedList<int>();

        // Добавление в конец (AddLast - O(1))
        stopwatch.Start();
        for (int i = 0; i < count; i++) linkedList.AddLast(i);
        stopwatch.Stop();
        Console.WriteLine($"LinkedList | Добавление (в конец): {stopwatch.ElapsedMilliseconds} мс");

        // Поиск (Contains - O(n), т.к. требуется линейный обход узлов)
        stopwatch.Restart();
        bool found = linkedList.Contains(count - 1);
        stopwatch.Stop();
        Console.WriteLine($"           | Поиск: {stopwatch.ElapsedMilliseconds} мс (линейный обход)");

        // Удаление первого (RemoveFirst - O(1))
        stopwatch.Restart();
        linkedList.RemoveFirst();
        stopwatch.Stop();
        Console.WriteLine($"           | Удаление первого: {stopwatch.ElapsedTicks} такт(ов)\n");
    }

    static void RunDictionaryTests(int count)
    {
        var stopwatch = new Stopwatch();
        var dict = new Dictionary<int, string>();

        // Добавление (Add - O(1) в среднем)
        stopwatch.Start();
        for (int i = 0; i < count; i++) dict[i] = "Value_" + i;
        stopwatch.Stop();
        Console.WriteLine($"Dictionary | Добавление: {stopwatch.ElapsedMilliseconds} мс");

        // Поиск по ключу (ContainsKey - O(1) в среднем)
        stopwatch.Restart();
        bool found = dict.ContainsKey(count - 1);
        stopwatch.Stop();
        Console.WriteLine($"           | Поиск по ключу: {stopwatch.ElapsedTicks} такт(ов)");

        // Удаление (Remove - O(1) в среднем)
        stopwatch.Restart();
        dict.Remove(0);
        stopwatch.Stop();
        Console.WriteLine($"           | Удаление: {stopwatch.ElapsedTicks} такт(ов)\n");
    }
}
