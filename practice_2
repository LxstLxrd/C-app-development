using System;
using System.Collections;
using System.Collections.Generic;

public class GenericStack<T> : IEnumerable<T>
{
    private T[] _items;
    private int _count;
    private const int DefaultCapacity = 4;

    public GenericStack()
    {
        _items = new T[DefaultCapacity];
    }

    public GenericStack(int capacity)
    {
        _items = new T[Math.Max(capacity, 1)];
    }

    public int Count => _count;
    public int Capacity => _items.Length;

    // Добавление элемента на вершину стека
    public void Push(T item)
    {
        if (_count == _items.Length)
        {
            // Увеличиваем массив в 2 раза при переполнении
            int newCapacity = _items.Length * 2;
            Array.Resize(ref _items, newCapacity);
        }

        _items[_count++] = item;
    }

    // Удаление и возврат элемента с вершины стека
    public T Pop()
    {
        if (_count == 0)
        {
            throw new InvalidOperationException("Стек пуст.");
        }

        _count--;
        T item = _items[_count];
        _items[_count] = default!; // Предотвращаем утечку памяти (gc reference clearing)
        return item;
    }

    // Просмотр элемента с вершины без удаления
    public T Peek()
    {
        if (_count == 0)
        {
            throw new InvalidOperationException("Стек пуст.");
        }

        return _items[_count - 1];
    }

    // Безопасное извлечение с помощью out (паттерн TryGet)
    public bool TryPop(out T? value)
    {
        if (_count == 0)
        {
            value = default;
            return false;
        }

        _count--;
        value = _items[_count];
        _items[_count] = default!;
        return true;
    }

    // Реализация IEnumerable<T> через yield return
    public IEnumerator<T> GetEnumerator()
    {
        // Идем от вершины стека к его дну
        for (int i = _count - 1; i >= 0; i--)
        {
            yield return _items[i];
        }
    }

    IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
}

class Program
{
    static void Main()
    {
        var stack = new GenericStack<int>();
        stack.Push(10);
        stack.Push(20);
        stack.Push(30);

        Console.WriteLine($"Вершина стека (Peek): {stack.Peek()}"); // 30

        Console.WriteLine("Элементы в стеке (от вершины к дну):");
        foreach (var item in stack)
        {
            Console.WriteLine(item); // 30, 20, 10
        }

        Console.WriteLine($"Извлечено (Pop): {stack.Pop()}"); // 30
        Console.WriteLine($"Количество элементов после Pop: {stack.Count}"); // 2
    }
}

