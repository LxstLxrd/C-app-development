using System;
using System.Collections.Generic;
using System.Linq;

public record Combo(string Name, GameAction[] Sequence, TimeSpan Window);

public class ComboPerformedEventArgs : EventArgs
{
    public Combo Combo { get; }
    public ComboPerformedEventArgs(Combo combo) => Combo = combo;
}

public class ComboDetector
{
    private readonly List<Combo> _combos;
    private readonly Func<DateTime> _timeProvider;
    private readonly List<(GameAction Action, DateTime Timestamp)> _buffer = [];

    public event EventHandler<ComboPerformedEventArgs>? ComboPerformed;

    public ComboDetector(IEnumerable<Combo> combos, Func<DateTime> timeProvider)
    {
        _combos = [.. combos.OrderByDescending(c => c.Sequence.Length)]; // Сначала длинные комбо
        _timeProvider = timeProvider;
    }

    public void OnActionTriggered(object? sender, ActionEventArgs e)
    {
        var now = _timeProvider();
        _buffer.Add((e.Action, now));

        // Проверяем совпадения среди зарегистрированных комбо
        foreach (var combo in _combos)
        {
            if (CheckMatch(combo))
            {
                ComboPerformed?.Invoke(this, new ComboPerformedEventArgs(combo));
                _buffer.Clear(); // Очищаем буфер после успешного комбо
                break;
            }
        }
    }

    private bool CheckMatch(Combo combo)
    {
        if (_buffer.Count < combo.Sequence.Length) return false;

        // Берем последние N действий по длине комбо
        var slice = _buffer.TakeLast(combo.Sequence.Length).ToList();

        // Проверяем тайминговое окно
        var duration = slice.Last().Timestamp - slice.First().Timestamp;
        if (duration > combo.Window) return false;

        // Проверяем последовательность действий
        for (int i = 0; i < combo.Sequence.Length; i++)
        {
            if (slice[i].Action != combo.Sequence[i]) return false;
        }

        return true;
    }
}

public class InputRecorder
{
    private readonly List<(ConsoleKey Key, TimeSpan Delay)> _recordedInputs = [];
    private DateTime _startTime;

    public void StartRecording()
    {
        _startTime = DateTime.Now;
        _recordedInputs.Clear();
    }

    public void RecordKey(ConsoleKey key)
    {
        var delay = DateTime.Now - _startTime;
        _recordedInputs.Add((key, delay));
    }

    public Func<ConsoleKey> CreatePlaybackProvider()
    {
        int index = 0;
        return () =>
        {
            if (index >= _recordedInputs.Count) return ConsoleKey.Escape;
            var input = _recordedInputs[index++];
            return input.Key;
        };
    }
}
