using System;
using System.Collections.Generic;

public class DefeatingEventArgs : EventArgs
{
    public bool Cancel { get; set; }
}

public class Boss
{
    public string Name { get; }
    public int MaxHp { get; }
    private int _hp;
    private bool _isDefeated = false;

    public int Hp
    {
        get => _hp;
        set => _hp = Math.Max(0, value);
    }

    public event EventHandler<BossDamagedEventArgs>? Damaged;
    public event EventHandler<DefeatingEventArgs>? Defeating;
    public event EventHandler? Defeated;

    public Boss(string name, int maxHp)
    {
        Name = name;
        MaxHp = maxHp;
        Hp = maxHp;
    }

    public void TakeDamage(int amount)
    {
        if (_isDefeated) return;

        int actualDamage = Math.Min(amount, Hp);
        Hp -= actualDamage;

        SafeInvokeDamaged(new BossDamagedEventArgs(actualDamage, Hp));

        if (Hp == 0)
        {
            // 1. Создаем событие Defeating (до гибели)
            var defeatingArgs = new DefeatingEventArgs();
            SafeInvokeDefeating(defeatingArgs);

            // Если какой-либо подписчик отменил гибель
            if (defeatingArgs.Cancel)
            {
                return; // Босс не погибает
            }

            _isDefeated = true;
            SafeInvokeDefeated();
        }
    }

    // 3. Защита от сломанных подписчиков через GetInvocationList()
    private void SafeInvokeDamaged(BossDamagedEventArgs e)
    {
        if (Damaged == null) return;
        foreach (Delegate handler in Damaged.GetInvocationList())
        {
            try
            {
                ((EventHandler<BossDamagedEventArgs>)handler)(this, e);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Ошибка подписчика Damaged]: {ex.Message}");
            }
        }
    }

    private void SafeInvokeDefeating(DefeatingEventArgs e)
    {
        if (Defeating == null) return;
        foreach (Delegate handler in Defeating.GetInvocationList())
        {
            try
            {
                ((EventHandler<DefeatingEventArgs>)handler)(this, e);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Ошибка подписчика Defeating]: {ex.Message}");
            }
        }
    }

    private void SafeInvokeDefeated()
    {
        if (Defeated == null) return;
        foreach (Delegate handler in Defeated.GetInvocationList())
        {
            try
            {
                ((EventHandler)handler)(this, EventArgs.Empty);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Ошибка подписчика Defeated]: {ex.Message}");
            }
        }
    }
}

// 2. Механика ярости (срабатывает 1 раз, восстанавливает 50 HP и отписывается)
public class EnrageMechanic
{
    private bool _used = false;

    public void Attach(Boss boss) => boss.Defeating += OnDefeating;
    public void Detach(Boss boss) => boss.Defeating -= OnDefeating;

    private void OnDefeating(object? sender, DefeatingEventArgs e)
    {
        if (!_used && sender is Boss boss)
        {
            _used = true;
            e.Cancel = true; // Отменяем гибель
            boss.Hp = 50;    // Восстанавливаем 50 HP
            Console.WriteLine("[!] Дракон впадает в ярость!");

            // Автоматическая отписка после срабатывания
            boss.Defeating -= OnDefeating;
        }
    }
}

// 4. Рейд из нескольких боссов (RaidTracker)
public class RaidTracker
{
    private int _defeatedCount = 0;
    private readonly int _totalBosses;

    public event EventHandler? RaidCompleted;

    public RaidTracker(int totalBosses)
    {
        _totalBosses = totalBosses;
    }

    public void RegisterBoss(Boss boss)
    {
        boss.Defeated += OnBossDefeated;
    }

    private void OnBossDefeated(object? sender, EventArgs e)
    {
        if (sender is Boss boss)
        {
            _defeatedCount++;
            Console.WriteLine($"[RaidTracker] Босс {boss.Name} повержен! ({_defeatedCount}/{_totalBosses})");

            if (_defeatedCount >= _totalBosses)
            {
                Console.WriteLine("[RaidTracker] Все боссы повержены! Рейд успешно завершён!");
                RaidCompleted?.Invoke(this, EventArgs.Empty);
            }
        }
    }
}

