}

// Расширенный класс Boss для уровня 2
public class Boss
{
    public string Name { get; }
    public int MaxHp { get; }
    private int _hp;
    private bool _isDefeated = false;

    public int Hp
    {
        get => _hp;
        private set => _hp = Math.Max(0, value);
    }

    public BossPhase Phase { get; private set; } = BossPhase.Phase1;

    public event EventHandler<BossDamagedEventArgs>? Damaged;
    public event EventHandler? Defeated;
    public event EventHandler<PhaseChangedEventArgs>? PhaseChanged;

    public Boss(string name, int maxHp)
    {
        Name = name;
        MaxHp = maxHp;
        Hp = maxHp;
    }

    public void TakeDamage(int amount)
    {
        if (_isDefeated) return;

        int actualDamage = Math.Min(amount, Hp);
        Hp -= actualDamage;

        OnDamaged(new BossDamagedEventArgs(actualDamage, Hp));

        // Проверка смены фаз, если босс еще жив
        if (Hp > 0)
        {
            CheckPhaseTransitions();
        }
        else
        {
            _isDefeated = true;
            OnDefeated();
        }
    }

    private void CheckPhaseTransitions()
    {
        BossPhase targetPhase = CalculateCurrentPhase();
        
        // 2. Если мощный удар «перепрыгнул» фазу, вызываем события по порядку (1 -> 2 -> 3)
        while (Phase != targetPhase)
        {
            BossPhase oldPhase = Phase;
            Phase = GetNextPhase(Phase);
            OnPhaseChanged(new PhaseChangedEventArgs(oldPhase, Phase));
        }
    }

    private BossPhase CalculateCurrentPhase()
    {
        double ratio = (double)Hp / MaxHp;
        if (ratio > 2.0 / 3.0) return BossPhase.Phase1;
        if (ratio > 1.0 / 3.0) return BossPhase.Phase2;
        return BossPhase.Phase3;
    }

    private BossPhase GetNextPhase(BossPhase current) => current switch
    {
        BossPhase.Phase1 => BossPhase.Phase2,
        BossPhase.Phase2 => BossPhase.Phase3,
        _ => BossPhase.Phase3
    };

    protected virtual void OnDamaged(BossDamagedEventArgs e) => Damaged?.Invoke(this, e);
    protected virtual void OnDefeated() => Defeated?.Invoke(this, EventArgs.Empty);
    protected virtual void OnPhaseChanged(PhaseChangedEventArgs e) => PhaseChanged?.Invoke(this, e);
}

// 4. Подписчик DamageLog
public class DamageLog
{
    private readonly List<int> _damages = [];

    public void Attach(Boss boss) => boss.Damaged += OnDamaged;
    public void Detach(Boss boss) => boss.Damaged -= OnDamaged;

    private void OnDamaged(object? sender, BossDamagedEventArgs e)
    {
        _damages.Add(e.Amount);
    }

    public void PrintStatistics()
    {
        int count = _damages.Count;
        int sum = 0;
        int max = 0;

        foreach (var d in _damages)
        {
            sum += d;
            if (d > max) max = d;
        }

        Console.WriteLine($"[DamageLog] Ударов: {count}, Суммарный урон: {sum}, Максимальный урон: {max}");
    }
}

