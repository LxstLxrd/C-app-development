using System;
using System.Collections.Generic;

public enum GameAction { MoveUp, MoveDown, MoveLeft, MoveRight, Attack, Pause }

public class ActionEventArgs : EventArgs
{
    public GameAction Action { get; }
    public ActionEventArgs(GameAction action) => Action = action;
}

public class ActionMap
{
    private readonly Dictionary<ConsoleKey, GameAction> _bindings = new()
    {
        { ConsoleKey.W, GameAction.MoveUp },
        { ConsoleKey.S, GameAction.MoveDown },
        { ConsoleKey.A, GameAction.MoveLeft },
        { ConsoleKey.D, GameAction.MoveRight },
        { ConsoleKey.Spacebar, GameAction.Attack },
        { ConsoleKey.P, GameAction.Pause }
    };

    public event EventHandler<ActionEventArgs>? ActionTriggered;

    public void HandleKeyPressed(object? sender, KeyPressedEventArgs e)
    {
        if (_bindings.TryGetValue(e.Key, out GameAction action))
        {
            ActionTriggered?.Invoke(this, new ActionEventArgs(action));
        }
    }

    public void Rebind(GameAction action, ConsoleKey newKey)
    {
        if (_bindings.ContainsKey(newKey))
        {
            throw new InvalidOperationException($"Клавиша {newKey} уже занята другим действием!");
        }

        // Удаляем старый привязанный ключ для этого действия, если он был
        foreach (var pair in _bindings)
        {
            if (pair.Value == action)
            {
                _bindings.Remove(pair.Key);
                break;
            }
        }

        _bindings[newKey] = action;
    }
}

public class Hero
{
    public int X { get; private set; } = 0;
    public int Y { get; private set; } = 0;
    private readonly int _fieldSize = 10;

    public void Subscribe(ActionMap actionMap)
    {
        actionMap.ActionTriggered += OnActionTriggered;
    }

    public void Unsubscribe(ActionMap actionMap)
    {
        actionMap.ActionTriggered -= OnActionTriggered;
    }

    private void OnActionTriggered(object? sender, ActionEventArgs e)
    {
        int newX = X, newY = Y;

        switch (e.Action)
        {
            case GameAction.MoveUp: newY++; break;
            case GameAction.MoveDown: newY--; break;
            case GameAction.MoveLeft: newX--; break;
            case GameAction.MoveRight: newX++; break;
            case GameAction.Attack:
                Console.WriteLine("Удар мечом!");
                return;
        }

        if (e.Action >= GameAction.MoveUp && e.Action <= GameAction.MoveRight)
        {
            if (newX >= 0 && newX < _fieldSize && newY >= 0 && newY < _fieldSize)
            {
                X = newX;
                Y = newY;
                Console.WriteLine($"Герой переместился в ({X}, {Y})");
            }
            else
            {
                Console.WriteLine("Упёрся в стену!");
            }
        }
    }
}

public class InputStatistics
{
    private readonly Dictionary<GameAction, int> _stats = [];

    public void Track(ActionMap actionMap)
    {
        actionMap.ActionTriggered += OnActionTriggered;
    }

    private void OnActionTriggered(object? sender, ActionEventArgs e)
    {
        if (!_stats.ContainsKey(e.Action)) _stats[e.Action] = 0;
        _stats[e.Action]++;
    }

    public void PrintReport()
    {
        Console.WriteLine("\n--- Статистика ввода ---");
        foreach (var pair in _stats)
        {
            Console.WriteLine($"{pair.Key}: {pair.Value} раз(а)");
        }
    }
}

