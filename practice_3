using System;
using System.Collections.Generic;

public class KeyPressedEventArgs : EventArgs
{
    public ConsoleKey Key { get; }
    public KeyPressedEventArgs(ConsoleKey key) => Key = key;
}

public class InputManager
{
    private readonly Func<ConsoleKey> _keyProvider;

    public event EventHandler<KeyPressedEventArgs>? KeyPressed;
    public event EventHandler? QuitRequested;

    public InputManager(Func<ConsoleKey> keyProvider)
    {
        _keyProvider = keyProvider;
    }

    public void Run()
    {
        while (true)
        {
            ConsoleKey key = _keyProvider();
            if (key == ConsoleKey.Escape)
            {
                QuitRequested?.Invoke(this, EventArgs.Empty);
                break;
            }
            KeyPressed?.Invoke(this, new KeyPressedEventArgs(key));
        }
    }
}

public class Hero
{
    public int X { get; private set; } = 0;
    public int Y { get; private set; } = 0;
    private readonly int _fieldSize = 10;

    public void Subscribe(InputManager inputManager)
    {
        inputManager.KeyPressed += OnKeyPressed;
    }

    private void OnKeyPressed(object? sender, KeyPressedEventArgs e)
    {
        int newX = X, newY = Y;

        if (e.Key == ConsoleKey.W) newY++;
        else if (e.Key == ConsoleKey.S) newY--;
        else if (e.Key == ConsoleKey.A) newX--;
        else if (e.Key == ConsoleKey.D) newX++;

        // Проверка границ поля 10x10
        if (newX >= 0 && newX < _fieldSize && newY >= 0 && newY < _fieldSize)
        {
            X = newX;
            Y = newY;
            Console.WriteLine($"Герой переместился в позицию ({X}, {Y})");
        }
        else
        {
            Console.WriteLine("Упёрся в стену!");
        }
    }
}

